{
  "name": "captura-desk",
  "private": true,
  "version": "0.2.0",
  "description": "A project-based desktop workflow documentation workspace",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && node scripts/start.mjs",
    "test:desktop": "npm run build && node scripts/smoke.mjs",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "format": "prettier --write src electron tests scripts *.json *.ts index.html README.md CHANGELOG.md docs .github",
    "format:check": "prettier --check src electron tests scripts *.json *.ts index.html README.md CHANGELOG.md docs .github",
    "check": "npm run typecheck && npm test && npm run format:check",
    "test:recording": "npm run build && node scripts/recording-smoke.mjs",
    "test:ai": "npm run build && node scripts/ai-smoke.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "koffi": "^3.3.1",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.3.0",
    "uiohook-napi": "^1.5.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^44.4.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  },
  "productName": "Captura Desk"
}
